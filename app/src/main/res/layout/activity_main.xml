<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- Хедър -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#16213e"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="КЕЦ GPS"
            android:textColor="#e94560"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingEnd="8dp"/>

        <EditText
            android:id="@+id/itn_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="ИТН номера..."
            android:textColor="#ffffff"
            android:background="@drawable/input_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"/>

        <ImageButton
            android:id="@+id/mic_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="@drawable/btn_bg"
            android:contentDescription="Микрофон"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/search_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="GO"
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:background="@drawable/btn_bg"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Карта -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Панел с управление -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#16213e"
        android:padding="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_load"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="📁 Зареди"
            android:textColor="#ffffff"
            android:background="@drawable/btn_bg"
            android:layout_margin="4dp"/>

        <Button
            android:id="@+id/btn_map"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="🗺️ Карта"
            android:textColor="#aaaaaa"
            android:background="@drawable/btn_bg"
            android:layout_margin="4dp"
            android:backgroundTint="#0f3460"/>

        <Button
            android:id="@+id/btn_sat"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="🛰️ Сателит"
            android:textColor="#aaaaaa"
            android:background="@drawable/btn_bg"
            android:layout_margin="4dp"
            android:backgroundTint="#0f3460"/>

        <Button
            android:id="@+id/btn_gmaps"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="📍 Google"
            android:textColor="#ffffff"
            android:background="@drawable/btn_bg"
            android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Панел с резултати (надвижаемо) -->
    <LinearLayout
        android:id="@+id/results_panel"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="vertical"
        android:background="#0f0f1e"
        android:visibility="gone"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="space_between">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Резултати"
                android:textColor="#e94560"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="✕"
                android:textSize="12sp"
                android:background="@drawable/btn_bg"
                android:textColor="#ffffff"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Статус текст на дъно -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Заредени: 0 записа"
        android:textColor="#aaaaaa"
        android:textSize="12sp"
        android:background="#0f0f1e"
        android:padding="8dp"/>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000088"
        android:visibility="gone"
        android:gravity="center">

        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:orientation="vertical"
            android:background="#16213e"
            android:gravity="center"
            android:padding="16dp">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Зареждане..."
                android:textColor="#e94560"
                android:textSize="14sp"
                android:textAlignment="center"/>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
